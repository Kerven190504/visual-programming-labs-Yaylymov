<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Начало оплаты" />
    <bpmn:task id="Task_Input" name="Ввод лицевого счета" />
    <bpmn:exclusiveGateway id="Gateway_CheckAccount" name="Счет найден?" />
    <bpmn:task id="Task_SelectCard" name="Выбор карты и подтверждение" />
    <bpmn:parallelGateway id="Gateway_Fork" name="Параллельное исполнение" />
    <bpmn:task id="Task_Pay" name="Списание средств и чек" />
    <bpmn:task id="Task_Notify" name="Уведомление ЖКХ / ЕРИП" />
    <bpmn:parallelGateway id="Gateway_Join" />
    <bpmn:endEvent id="EndEvent_Success" name="Услуга оплачена" />
    <bpmn:endEvent id="EndEvent_Fail" name="Ошибка: счет не найден" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Input" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Input" targetRef="Gateway_CheckAccount" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Да" sourceRef="Gateway_CheckAccount" targetRef="Task_SelectCard" />
    <bpmn:sequenceFlow id="Flow_No" name="Нет" sourceRef="Gateway_CheckAccount" targetRef="EndEvent_Fail" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SelectCard" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Fork1" sourceRef="Gateway_Fork" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_Fork2" sourceRef="Gateway_Fork" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_Join1" sourceRef="Task_Pay" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Join2" sourceRef="Task_Notify" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Gateway_Join" targetRef="EndEvent_Success" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="139" y="145" width="79" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Input_di" bpmnElement="Task_Input">
        <dc:Bounds x="250" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CheckAccount_di" bpmnElement="Gateway_CheckAccount" isMarkerVisible="true">
        <dc:Bounds x="405" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="394" y="65" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectCard_di" bpmnElement="Task_SelectCard">
        <dc:Bounds x="510" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Fork_di" bpmnElement="Gateway_Fork">
        <dc:Bounds x="665" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Pay_di" bpmnElement="Task_Pay">
        <dc:Bounds x="760" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify">
        <dc:Bounds x="760" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join">
        <dc:Bounds x="915" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="1022" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="997" y="145" width="87" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Fail_di" bpmnElement="EndEvent_Fail">
        <dc:Bounds x="412" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="395" y="255" width="71" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="196" y="120" /><di:waypoint x="250" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="350" y="120" /><di:waypoint x="405" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes"><di:waypoint x="455" y="120" /><di:waypoint x="510" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No"><di:waypoint x="430" y="145" /><di:waypoint x="430" y="212" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="610" y="120" /><di:waypoint x="665" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fork1_di" bpmnElement="Flow_Fork1"><di:waypoint x="690" y="95" /><di:waypoint x="690" y="70" /><di:waypoint x="760" y="70" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fork2_di" bpmnElement="Flow_Fork2"><di:waypoint x="690" y="145" /><di:waypoint x="690" y="190" /><di:waypoint x="760" y="190" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join1_di" bpmnElement="Flow_Join1"><di:waypoint x="860" y="70" /><di:waypoint x="940" y="70" /><di:waypoint x="940" y="95" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join2_di" bpmnElement="Flow_Join2"><di:waypoint x="860" y="190" /><di:waypoint x="940" y="190" /><di:waypoint x="940" y="145" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_End_di" bpmnElement="Flow_End"><di:waypoint x="965" y="120" /><di:waypoint x="1022" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
